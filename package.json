    "components:coverage": "node --experimental-strip-types scripts/docs/component-coverage.ts",
    "components:test-coverage": "node scripts/check-component-tests.mjs",
    "components:exports:sync": "node scripts/sync-component-exports.mjs --write && prettier --write package.json",
    "components:exports:check": "node scripts/sync-component-exports.mjs --check",
    "components:size-check": "node scripts/check-component-sizes.mjs",
    "storybook:generate": "bun scripts/storybook/generate-component-stories.ts",
    "storybook:coverage": "bun scripts/storybook/check-component-stories.ts",
    "storybook:dev": "bun run storybook:generate && storybook dev -p 6006",
    "storybook:build": "bun run storybook:generate && storybook build",
    "examples:smoke": "node --experimental-strip-types scripts/docs/examples-smoke.ts",
    "docs:ci": "bun run docs:generate && bun run docs:typecheck && bun run docs:impact && bun run docs:coverage && bun run components:coverage && bun run examples:smoke && bun run docs:build",
    "release:config:check": "node scripts/check-release-config.mjs",
    "release:check": "npm run release:config:check && npm run typecheck && npm run build && npm run components:size-check && npm test && npm run docs:ci && npm run install:smoke",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install:smoke": "node scripts/install-smoke.mjs"
  },
